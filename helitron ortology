COMPLEMENT = str.maketrans("ACGTNacgtn", "TGCANtgcan")


def revcomp(seq: str) -> str:
    return seq.translate(COMPLEMENT)[::-1]


# ---------------------------------------------------------------------------
# Leitura de FASTA (implementação leve, sem dependência de Biopython)
# ---------------------------------------------------------------------------
def load_fasta(path: str) -> Dict[str, str]:
    """Carrega um FASTA inteiro em memória: {header_id: sequence}."""
    seqs: Dict[str, List[str]] = {}
    current_id = None
    with open(path) as fh:
        for line in fh:
            line = line.rstrip("\n")
            if not line:
                continue
            if line.startswith(">"):
                current_id = line[1:].split()[0]
                seqs[current_id] = []
            else:
                if current_id is None:
                    raise ValueError(f"FASTA malformado em {path}: sequência antes de cabeçalho.")
                seqs[current_id].append(line.strip())
    return {k: "".join(v) for k, v in seqs.items()}


def write_fasta(records: List[Tuple[str, str]], path: str, width: int = 70) -> None:
    with open(path, "w") as fh:
        for header, seq in records:
            fh.write(f">{header}\n")
            for i in range(0, len(seq), width):
                fh.write(seq[i:i + width] + "\n")


# ---------------------------------------------------------------------------
# Estruturas de dados
